# Configuracion de la aplicacion EPM.
# Los valores se leen de variables de entorno; si existe el archivo .env
# (creado por deploy.sh en el servidor) sus valores tienen prioridad.

# --- Servidor web ---
# SECRET_KEY: cadena aleatoria. En produccion la genera deploy.sh.
# Cambiarla invalida todas las sesiones abiertas.
SECRET_KEY=pon_aqui_una_clave_aleatoria_larga

# --- Conexion MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=epm_user
MYSQL_PASSWORD=pon_aqui_la_contrasena
MYSQL_DB=epm_db
